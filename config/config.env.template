# ============================================================================
# Конфигурация hermes-argus — заполни свои значения и сохрани как config.env
# ============================================================================

# ── Модули (MODULE_*) — deploy.sh ставит только включённое.
#    Всё, что требует внешних сервисов, — OFF по умолчанию.
MODULE_CORE="ON"            # watchdog, liveness, auto-remediate, network-guard, ssl, check-updates
MODULE_INTEGRATIONS="ON"    # integration-discover (+systemd.path) и каскад-трекер фолбека
MODULE_TG_BOT="OFF"         # интерактивный Telegram-бот управления (poller + webhook)
MODULE_ANALYZER="OFF"       # L3 health-analyzer экосистема (LLM-анализ логов)
MODULE_HEARTBEAT="OFF"      # внешний dead man's switch (Dead Man's Snitch / GitHub Heartbeat)

# ── Серверный хост (Tailscale IP или любой адрес)
# Dashboard слушает на этом IP. Для Tailscale укажи IP!
# Если Hermes без Tailscale — `127.0.0.1`
HERMES_HOST="127.0.0.1"

# ── Порты
HERMES_PORT="9119"
NETDATA_PORT="19999"

# ── Telegram мониторинг-бот
# Токен бота мониторинга (создай через @BotFather)
WATCHDOG_BOT_TOKEN=""
# ID чата, куда бот шлёт алерты (твой user ID или группы)
WATCHDOG_CHAT_ID=""

# Основной Telegram-бот Hermes (gateway) конфигурируется в ~/.hermes/.env
# каноничным ключом TELEGRAM_BOT_TOKEN — дублей вида HERMES_BOT_* не заводим
# (убрано 2026-09-07: мёртвая конфигурация, код её не читает).

# ── Внешний Heartbeat (опционально)
# Dead Man's Snitch: https://nosnch.in/
DMS_SNITCH="change_me"
DMS_API_KEY="change_me"

# ── Circuit breaker — сколько авто-фиксов в час до стопа
BREAKER_MAX=3