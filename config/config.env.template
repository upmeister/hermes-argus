# ============================================================================
# Конфигурация hermes-argus — заполни свои значения и сохрани как config.env
# ============================================================================

# ── Модули (MODULE_*) — deploy.sh ставит только включённое.
#    Всё, что требует внешних сервисов, — OFF по умолчанию.
MODULE_CORE="ON"            # watchdog, liveness, auto-remediate, network-guard, ssl, check-updates
MODULE_INTEGRATIONS="ON"    # integration-discover (+systemd.path) и каскад-трекер фолбека
MODULE_TG_BOT="OFF"         # интерактивный Telegram-бот управления (poller + webhook)
MODULE_ANALYZER="OFF"       # L3 health-analyzer экосистема (LLM-анализ логов)
MODULE_HEARTBEAT="OFF"      # внешний dead man's switch (Dead Man's Snitch / GitHub Heartbeat)
MODULE_GH_HEARTBEAT="OFF"   # GitHub Heartbeat: авто-создание приватного репо + Actions-алерт
MODULE_DISCORD_BOT="OFF"    # Discord control plane (нужен DISCORD_BOT_TOKEN в .env)

# ── Серверный хост (Tailscale IP или любой адрес)
# Dashboard слушает на этом IP. Для Tailscale укажи IP!
# Если Hermes без Tailscale — `127.0.0.1`
HERMES_HOST="127.0.0.1"

# ── Порты
HERMES_PORT="9119"
NETDATA_PORT="19999"

# ── Telegram мониторинг-бот
# Токен бота мониторинга (создай через @BotFather)
WATCHDOG_BOT_TOKEN=""
# ID чата, куда бот шлёт алерты (твой user ID или группы)
WATCHDOG_CHAT_ID=""

# Основной Telegram-бот Hermes (gateway) конфигурируется в ~/.hermes/.env
# каноничным ключом TELEGRAM_BOT_TOKEN — дублей вида HERMES_BOT_* не заводим
# (убрано 2026-09-07: мёртвая конфигурация, код её не читает).

# ── Внешний Heartbeat (опционально)
# Бекенды включаются ключами в ~/.hermes/.env (runtime, НЕ здесь):
#   CRONPING_TOKEN — Cronping (рекомендуется, 5-мин; ключ Management API для
#     авто-создания heartbeat: CRONPING_API_KEY, см. cronping.com → Organization
#     settings → API keys)
#   DMS_SNITCH — Dead Man's Snitch (hourly free tier; deadmanssnitch.com →
#     создать snitch → ID из ping URL)
#   GH_TOKEN + GITHUB_REPO — GitHub Heartbeat (MODULE_GH_HEARTBEAT=ON; PAT:
#     classic repo+workflow или fine-grained Contents/Workflows RW)
DMS_SNITCH="change_me"
DMS_API_KEY="change_me"

# ── Circuit breaker — сколько авто-фиксов в час до стопа
BREAKER_MAX=3
# ── C1a Shadow bridge (ADR 0002) — ОПЦИОНАЛЬНО, default OFF ────────────────
# Сбор Hermes-owned discovery-метаданных в shadow-режиме (identity +
# config_health + effective_config). НЕ влияет на health verdicts, алерты
# или static-discovery authority (см. docs/adr/0002-hermes-discovery-sync-
# boundary.md). Включение на проде — отдельная авторизация с read-back.
#   HERMES_DISCOVERY_SHADOW        1 = собирать shadow-метаданные
#   HERMES_DISCOVERY_HERMES_PYTHON абсолютный путь к Hermes venv python
#                                  (например ~/.hermes/hermes-agent/venv/bin/python)
#   HERMES_DISCOVERY_SHADOW_TIMEOUT  ограничение всего shadow-вызова, сек (180)
# Эти переменные переносятся в ~/.hermes/.env при включении (runtime config).
HERMES_DISCOVERY_SHADOW=0
HERMES_DISCOVERY_HERMES_PYTHON=""
HERMES_DISCOVERY_SHADOW_TIMEOUT=180
