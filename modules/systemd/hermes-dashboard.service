[Unit]
Description=Hermes Dashboard API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.hermes/.env
Environment="HERMES_HOME=@HERMES_DIR@"
# Контракт A: CLI через адаптер (PM-установка v0.22.5 не гарантирует in-checkout
# venv; лаунчер резолвится на каждый старт юнита).
ExecStart=/usr/bin/python3 @HOME_DIR@/scripts/hermes-runtime.py hermes serve --host @HERMES_HOST@ --port @HERMES_PORT@
WorkingDirectory=@HERMES_DIR@

# Всегда перезапускать, даже после чистого выхода
Restart=always
RestartSec=5

# SIGTERM → ждём 30 сек → SIGKILL
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Лимиты памяти задаются через drop-in (см. modules/systemd/hermes-dashboard.service.d/)
# MemoryHigh, MemoryMax, OOMScoreAdjust — там

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target