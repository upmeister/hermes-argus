[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Контракт A: запуск через адаптер hermes-runtime.py — PM-установка Hermes
# v0.22.5 не гарантирует in-checkout venv; лаунчер резолвится на каждый старт,
# в юните нет generation-specific путей. Форма `hermes gateway run` через
# опубликованный лаунчер распознаётся каноническим матчером gateway.status.
ExecStart=/usr/bin/python3 @HOME_DIR@/scripts/hermes-runtime.py hermes gateway run
WorkingDirectory=@HERMES_DIR@
Environment="PATH=@HERMES_DIR@/hermes-agent/node_modules/.bin:/usr/bin:@HOME_DIR@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HERMES_HOME=@HERMES_DIR@"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target