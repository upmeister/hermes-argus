[Unit]
Description=Hermes Argus Telegram control-plane poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.hermes/.env
# Контракт A: poller и его библиотека webhook.py — stdlib-only, поэтому
# исполняются системным python3 (импорт соседей работает: каталог скрипта —
# sys.path[0]). Потребность TG_BOT в рантайме Hermes — только CLI (kanban
# через адаптер webhook'а); его наличие проверяет deploy preflight.
ExecStart=/usr/bin/python3 %h/.hermes/scripts/monitoring-bot-poller.py
Restart=always
RestartSec=10
StandardOutput=journal

[Install]
WantedBy=default.target
